# 백번 미리 묻다 환경변수 예시입니다. 복사해서 `.env`로 쓰고(git에 올리지 마세요), 값은 이 파일에 적지 마세요.
#   cp .env.example .env && chmod 600 .env
#   set -a; . ./.env; set +a
# 주석(#)으로 막아 둔 줄은 빈 값이면 오류가 나므로, 쓸 때만 주석을 풀고 값을 넣습니다.

# ---- 판단 모델(선택지 확률을 답하는 모델) ----
# 판단 모델 공급자: api(TypeSafe Jev) | upstage(Upstage Solar Decide) | mock(키 없이 시험, 외부 전송 없음). 비우면 api
PP_JEV_PROVIDER=
# TypeSafe Jev API 키. PP_JEV_PROVIDER=api일 때만 쓰며 api.typesafe.ai로만 보냅니다
TYPESAFE_API_KEY=
# Upstage API 키. PP_JEV_PROVIDER=upstage일 때만 쓰며 업스테이지 주소로만 보냅니다
UPSTAGE_API_KEY=
# 업스테이지 지역: 비우면 글로벌(api.upstage.ai), kr이면 한국 리전(kr.api.upstage.ai, 비공개 베타·접근 신청 필요)
PP_UPSTAGE_REGION=
# 업스테이지 API 기본 주소를 직접 지정(https만, 예: https://kr.api.upstage.ai/v1). 값이 있으면 PP_UPSTAGE_REGION보다 먼저 씁니다
UPSTAGE_BASE_URL=
# 판단 모델 이름. 비우면 api는 jev-latest, upstage는 solar-decide
PP_JEV_MODEL=
# Jev와 같은 형식으로 답하는 다른 판단 모델 서버 주소(예: 로컬 서버). PP_JEV_PROVIDER=api일 때만 쓰며 TypeSafe 키는 보내지 않습니다
PP_JEV_URL=
# PP_JEV_URL 서버가 키를 요구할 때만 넣는 키
PP_JEV_API_KEY=
# 같은 질문의 답을 data/jev-cache.sqlite에 저장해 다시 씁니다. 0이면 끔, 비우면 켬
PP_JEV_CACHE=
# 판단 모델 초당 호출 수 상한(기본 18)
# PP_JEV_RPS=

# ---- 문장 모델(이유·쟁점·공청회·계획서 문장을 쓰는 모델, 심층 분석에서 씀) ----
# 문장 모델 공급자: cli(claude -p 명령) | openai(OpenAI 호환 API) | exaone(LG EXAONE, 로컬 비상업 검증 전용) | mock. 비우면 cli
PP_LLM_PROVIDER=
# openai일 때 서버 주소(예: http://127.0.0.1:11434/v1)
PP_LLM_BASE_URL=
# openai일 때 모델 이름
PP_LLM_MODEL=
# openai일 때 인물 반응 단계에만 따로 쓸 모델 이름(비우면 PP_LLM_MODEL)
PP_LLM_MODEL_REACT=
# openai일 때 종합 단계에만 따로 쓸 모델 이름(비우면 PP_LLM_MODEL)
PP_LLM_MODEL_SYNTH=
# openai 서버가 키를 요구할 때만 넣는 키
PP_LLM_API_KEY=
# 문장 모델 온도(기본 0.7)
# PP_LLM_TEMPERATURE=
# cli일 때 인물 반응 단계 모델(기본 haiku)
# PP_REACT_MODEL=
# cli일 때 종합 단계 모델(기본 sonnet)
# PP_SYNTH_MODEL=
# 실행 전체 한도입니다. 모든 역할과 실패·재시도를 포함합니다.
# PP_MAX_CALLS=100000
# PP_MAX_OUTPUT_TOKENS=16384
# PP_MAX_RETRIES=2
# PP_MAX_CONCURRENCY=8
# PP_MAX_COST_USD=10
# 문장 모델의 백만 토큰당 상한 단가입니다. 두 역할 중 비싼 모델을 포괄합니다.
# 로컬 무료 서버는 둘 다 0으로 명시합니다. 단가가 없으면 금액 제한 실행을 막습니다.
# PP_LLM_INPUT_USD_PER_M=
# PP_LLM_OUTPUT_USD_PER_M=
# 사용자 지정 판단 서버의 백만 토큰당 단가입니다.
# PP_JEV_INPUT_USD_PER_M=
# PP_JEV_OUTPUT_USD_PER_M=
# LG EXAONE API 키. exaone일 때만 쓰며, 이용 조건(비상업)을 직접 확인하세요
EXAONE_API_KEY=
# exaone을 쓰려면 1(로컬 주소에서만 서버를 엽니다). 비우면 exaone 호출을 막습니다
PP_EXAONE_LOCAL_ONLY=
# exaone 추론을 끄려면 0. 비우면 켬
PP_EXAONE_THINKING=
# exaone 출력 토큰 상한(1~16384, 기본 16384)
# PP_EXAONE_MAX_TOKENS=
# 화면에 보일 모델 구성 이름(global | korean | local | mock). 비우면 실제 설정에서 고름
PP_MODEL_PROFILE=

# ---- 선택: 자료 가져오기 ----
# 국민참여입법센터 정보공개 서비스 신청 계정(@ 앞부분). 비우면 공개 목록 화면을 읽습니다
LAWMAKING_OC=
# KOSIS 공유서비스 API 키(engine/scripts의 통계 내려받기 스크립트용)
KOSIS_API_KEY=
# 공공데이터포털 서비스 키(engine/scripts의 실거래가 내려받기 스크립트용)
DATA_GO_KR_KEY=
