{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hosungseo/policy-preview-engine/schemas/field-verification-v1.schema.json",
  "title": "현장 확인 회수 기록 (Field Verification Log v1.0)",
  "description": "합성 미리보기 이후 실제로 국민·담당자를 만나 들은 결과를 적고, 미리 예측한 막힘·집단과 적중·오탐·놓침을 대조하는 기록 형식입니다. 실명·주민등록번호·전화번호 등 개인정보는 적지 않습니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_title", "entries"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "description": "비교 기준이 된 미리보기 실행 ID(예: u_... 또는 정책 ID)"
    },
    "policy_id": {
      "type": "string",
      "description": "정책 식별자(선택)"
    },
    "policy_title": {
      "type": "string",
      "minLength": 1,
      "description": "정책 또는 안내문 제목"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "기록 작성일(YYYY-MM-DD)"
    },
    "panel_version": {
      "type": ["string", "null"],
      "description": "비교 기준 실행의 패널 버전(선택)"
    },
    "source_revision": {
      "type": ["string", "null"],
      "description": "비교 기준 실행의 원본 데이터 revision(선택)"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "visit_date",
          "group_label",
          "venue",
          "participant_count",
          "item_kind",
          "outcome",
          "field_finding",
          "action_taken"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1,
            "description": "기록 항목 고유 번호(예: fv-001)"
          },
          "visit_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "현장 방문·면담 날짜(YYYY-MM-DD)"
          },
          "group_label": {
            "type": "string",
            "minLength": 1,
            "description": "실제로 만난 집단 이름(예: 70세 이상, 농어민)"
          },
          "venue": {
            "type": "string",
            "minLength": 1,
            "description": "만난 장소·창구 유형(예: 경로당·노인복지관, 행정복지센터). 실명·개인 연락처 금지"
          },
          "participant_count": {
            "type": "integer",
            "minimum": 1,
            "description": "실제 대화·면담에 참여한 인원 수"
          },
          "predicted_ref": {
            "type": ["string", "null"],
            "description": "비교한 미리보기 예측 항목 ID 또는 제목. 합성이 놓친 신규 발견이면 null 또는 빈 문자열"
          },
          "item_kind": {
            "type": "string",
            "enum": ["group", "blocker", "missing_party", "unpredicted"],
            "description": "항목 구분: group(예측 집단), blocker(예측 막힘·쟁점), missing_party(명단 외 당사자), unpredicted(예측 밖 현장 신규 발견)"
          },
          "outcome": {
            "type": "string",
            "enum": ["hit", "false_positive", "miss", "unverified"],
            "description": "현장 대조 판정: hit(적중), false_positive(오탐), miss(놓침), unverified(미확인)"
          },
          "field_finding": {
            "type": "string",
            "minLength": 1,
            "description": "현장에서 실제로 들은 핵심 내용 요약(실명·주민번호·전화번호 금지)"
          },
          "action_taken": {
            "type": "string",
            "enum": ["revised", "planned", "no_change", "pending"],
            "description": "문안·정책 수정 반영 여부"
          },
          "review_minutes": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "담당자 현장 확인 및 검토 소요 시간(분, 선택)"
          },
          "notes": {
            "type": "string",
            "description": "추가 메모(선택)"
          }
        }
      }
    }
  }
}
